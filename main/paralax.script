--[[  Defold Vignette # 1:  Parallax Techniques
=============================================================================================

Lua Script File:  gController.script

Script Summary: This script provides the following logic:

(1) Moves the foreGround Game Objects to the left during each update cycle
(2) Resets foreGround Game Objects when they moves out of the active viewport

=============================================================================================
--]] 

-- Setup a table with the foreGround panel IDs
--[[  Defold Vignette # 1:  Parallax Techniques
=============================================================================================
Lua Script File:  gController.script
=============================================================================================
--]] 

-- Setup a table com os IDs dos Game Objects do foreground
-- Usamos os caminhos absolutos a partir da coleção 'paralax' para achar os objetos irmãos
local gSegments = { "foreGround1", "foreGround2", "foreGround3" }

function init(self)
	self.gImageSize = go.get('foreGround1#sprite', 'size')
	self.parallax_factor = 0.5 -- 0.5 = move à metade da velocidade do player (fundo distante)
	self.player_x = 0
end

function update(self, dt)
	local width = self.gImageSize.x

	-- Calcula a posição base do parallax baseada no movimento do player
	local base_x = self.player_x * self.parallax_factor

	for i, p in ipairs(gSegments) do
		-- Cada segmento fica espaçado pelo seu tamanho original
		local target_x = ((i - 2) * width) + base_x

		-- Aplica a posição mantendo o looping contínuo
		local pos = go.get_position(p)
		pos.x = target_x
		go.set_position(pos, p)
	end
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set_player_pos") then
		self.player_x = message.x
	end
end